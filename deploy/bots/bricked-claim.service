[Unit]
Description=Bricked Sorting claim server (Discord + task chart)
After=network-online.target
Wants=network-online.target

[Service]
User=bot-bricked-claim
Group=bot-bricked-claim
# systemd reads this as root, so the file stays root-only (0600).
EnvironmentFile=/etc/bricked-claim/bot.env
Environment=BRICKED_DB=/var/lib/bricked-claim/claims.db
WorkingDirectory=/opt/bricked-claim/src/kratos/claim-bot
ExecStart=/opt/bricked-claim/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8701 --proxy-headers --no-server-header
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/bricked-claim
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
