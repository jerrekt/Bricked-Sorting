# /etc/bricked-claim/bot.env  (root only, mode 0600). Never commit the real one.
# Discord application: Developer Portal > your app > General Information
DISCORD_PUBLIC_KEY=
# Discord user ID : first name, comma separated. IDs also go in Mnemosyne private/.
DISCORD_USERS=
# Channel webhook for the task feed (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=
# Who can override any task from Discord
BRICKED_ADMIN=Branden
# Names offered on the website
BRICKED_SITE_NAMES=Branden,Ethan,Marshall,Vivek
# sha256 of the team password, made with:  printf '%s' 'THE-PASSWORD' | sha256sum
BRICKED_TEAM_PASSWORD_SHA256=
# Website buttons: 1 = on, 0 = off (Discord works either way)
BRICKED_SITE_WRITES=0
BRICKED_ALLOWED_ORIGIN=https://bricked-01.adsuaracloud.com
